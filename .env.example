# 이 파일은 '예시'다. 복사해서 .env 로 만들고 실제 값을 채운다:  cp .env.example .env
# .env 는 .gitignore 로 커밋되지 않으며, 코드가 시작할 때 자동으로 읽는다(load_dotenv).
# 배포 환경에서는 .env 대신 클라우드가 실제 환경변수를 주입해도 된다(그게 우선).
#
# 기본 배치: 임베딩·재순위는 내 컴퓨터(fastembed), 답변 생성·추출은 게이트웨이.
#   → 대화 원문은 밖으로 나가지 않는다. 키는 답변 생성 때문에 필요하다.

# --- 답변 생성용 키 (https://openrouter.ai/keys) ---
# 코드는 키를 환경변수/.env 에서만 읽으며, 절대 하드코딩하지 않는다.
# 자기 서버에 채팅 모델을 올려 뒀다면 아래 '전부 내 장비' 묶음을 쓰면 이 키가 필요 없다.
OPENROUTER_API_KEY=sk-or-your-key-here


# ===========================================================================
#  조합 1 — 그대로 쓰기 (위 키만)
# ===========================================================================
#  임베딩·재순위: 내 컴퓨터   |   답변 생성·추출: OpenRouter


# ===========================================================================
#  조합 2 — 전부 내 장비에서 (바깥 호출 0)
# ===========================================================================
#  Ollama·vLLM 같은 OpenAI 호환 서버에 채팅 모델을 올려 두고 그쪽을 가리킨다.
#  임베딩·재순위는 이미 로컬이므로 이 셋만 채우면 키가 필요 없어진다.
# MNEMOSURE_BASE_URL=http://<내-GPU호스트>:11434/v1
# MNEMOSURE_API_KEY=ollama                 # 키를 안 보는 서버라도 SDK가 값을 요구한다
# MNEMOSURE_MODEL_BRAIN=<올려 둔 모델>
# MNEMOSURE_MODEL_FLASH=<올려 둔 모델>


# ===========================================================================
#  조합 3 — 전부 게이트웨이로 (GPU가 없어 첫 색인이 느릴 때)
# ===========================================================================
# MNEMOSURE_EMBED_PROVIDER=api
# MNEMOSURE_RERANK_PROVIDER=api
#  ※ 임베딩 방식을 바꾸면 벡터가 달라진다 — 실행하면 안내가 뜨고,
#     python -m mnemosure.reembed 로 창고를 한 번 다시 계산하면 된다.


# --- 선택: 모델 이름 (local 과 api 가 서로 다른 변수를 본다) ---
# MNEMOSURE_MODEL_BRAIN=qwen/qwen3.7-plus
# MNEMOSURE_MODEL_FLASH=qwen/qwen3.5-flash-02-23
# MNEMOSURE_MODEL_EMBED_LOCAL=intfloat/multilingual-e5-large            # EMBED_PROVIDER=local
# MNEMOSURE_MODEL_EMBED=baai/bge-m3                                     # EMBED_PROVIDER=api
# MNEMOSURE_MODEL_RERANK_LOCAL=jinaai/jina-reranker-v2-base-multilingual # RERANK_PROVIDER=local
# MNEMOSURE_MODEL_RERANK=cohere/rerank-4-fast                           # RERANK_PROVIDER=api

# --- 선택: 임베딩만 다른 서버로 (재순위는 이 방법으로 못 옮긴다) ---
# EMBED_PROVIDER=api 로 두고 임베딩만 자기 GPU 서버로 보낼 때.
# MNEMOSURE_EMBED_BASE_URL=http://<GPU호스트>:11434/v1
# MNEMOSURE_EMBED_API_KEY=ollama
# MNEMOSURE_MODEL_EMBED=<그 서버에 올려 둔 임베딩 모델>

# --- 선택: 로컬 계산 가속 (임베딩·재순위가 local 일 때만) ---
# fastembed 는 기본이 CPU다. 기억이 많으면 첫 색인이 길어지므로 장비에 맞춰 켠다.
# MNEMOSURE_LOCAL_THREADS=8          # CPU 스레드 수
# MNEMOSURE_LOCAL_CUDA=1             # CUDA 사용 (onnxruntime-gpu 설치 필요)
# MNEMOSURE_LOCAL_DEVICE_IDS=0,1     # 쓸 GPU 번호
# ※ AMD·ROCm 등 CUDA가 아닌 장비는 표준 onnxruntime 이 지원하지 않는다 —
#   그 경우 임베딩만 그 장비의 추론 서버로 보내는 편이 낫다(아래 '임베딩만 다른 서버로').

# --- 선택: 회수·정직 게이트 조정 ---
# MNEMOSURE_CANDIDATE_K=40      # 1차 검색이 남길 후보 수. 여기서 잘리면 재순위도 게이트도 못 본다.
# MNEMOSURE_EVIDENCE_N=4        # 재순위 후 씨앗 증거로 쓸 상위 수
# MNEMOSURE_RERANK_FLOOR=       # 재순위 점수 문턱 (모델마다 척도가 다르다 — 바꿨으면 재보고 조정)
# MNEMOSURE_COSINE_FLOOR=       # 재순위를 끈 경우의 코사인 문턱 (local 0.85 · api 0.35)
#                               #   임베딩 모델마다 분포가 완전히 다르다 — e5 는 무관한 쌍도 0.83
# MNEMOSURE_E5_PREFIX=on        # e5 접두어 붙이기 (기본 끔 — 실측에서 회수가 나빠졌다)
# MNEMOSURE_RERANK=off          # 재순위를 아예 생략(코사인 폴백)
